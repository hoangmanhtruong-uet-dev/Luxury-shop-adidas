# Copy file này thành .env và điền thông tin của bạn

# ============================
# DATABASE (PostgreSQL — Supabase)
# ============================
# Local dev (Docker): docker run -d --name pg-dev -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=website_banhang -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_banhang?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/website_banhang?schema=public"
# Dedicated disposable DB only; integration runner refuses names not ending with _test.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_banhang_test?schema=public"
# --- Production: lấy ở Supabase dashboard → Project Settings → Database ---
# Thay [ref] = project ref, [PASSWORD] = db password (ký tự đặc biệt phải URL-encode,
# vd @ → %40). Region dưới là ví dụ — dùng đúng region của project bạn.
# 1) Runtime/serverless — Supavisor pooler, port 6543, transaction mode:
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 2) Migrate/deploy 1 lần — direct connection, host db.[ref], port 5432, KHÔNG qua pooler
#    (DDL trong pooled transaction-mode sẽ fail):
# DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres"
# Lưu ý: ?pgbouncer=true bắt buộc khi qua pooler, nếu không Prisma giữ prepared
# statement per-connection và giao dịch dài (checkout/webhook) sẽ lỗi.

# ============================
# AUTHENTICATION
# ============================
# Tạo bằng lệnh: openssl rand -base64 32
JWT_SECRET="YOUR_LEGACY_JWT_SECRET_IF_REQUIRED"
JWT_ACCESS_SECRET="YOUR_ACCESS_TOKEN_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="YOUR_REFRESH_TOKEN_SECRET_AT_LEAST_32_CHARS"
ACCESS_TOKEN_TTL="15m"
# Positive integer seconds; required in production.
REFRESH_TOKEN_TTL="604800"

# ============================
# RATE LIMIT
# ============================
# NOTE: RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX_ATTEMPTS are legacy placeholders and
# are NOT read by the code — every call site passes explicit inline values.
# The setting that actually matters is TRUST_PROXY, see below.
# TRUST_PROXY **must be true in production**. When it is false every request
# collapses to a single "direct-client" identity, so /api/auth/login's
# 5-per-15-minutes budget becomes 5 logins for the entire site.
TRUST_PROXY="true"
RATE_LIMIT_TRUST_PROXY_HOPS="1"

# ============================
# CRON (Phase 2.5)
# ============================
# Required in production (>= 32 chars). Without it BOTH /api/admin/cron/* routes
# reject every request forever and the outbox silently stops draining.
# Generate with: openssl rand -hex 32
CRON_SECRET="YOUR_CRON_SECRET_AT_LEAST_32_RANDOM_CHARS"

# ============================
# GOOGLE OAUTH / SUPABASE
# ============================
# These are PUBLIC (anon role). They are embedded in the client bundle; security
# depends entirely on Supabase RLS being enabled on every table.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# NEVER use the service_role key here — it bypasses RLS and is server-only.

# ============================
# PAYOS (only needed if you accept PayOS payments)
# ============================
# Absent values make src/lib/payment/payos.ts throw at import time rather than
# silently verifying webhooks against a placeholder checksum key.
PAYOS_CLIENT_ID="YOUR_PAYOS_CLIENT_ID"
PAYOS_API_KEY="YOUR_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="YOUR_PAYOS_CHECKSUM_KEY"

# ============================
# STORAGE
# ============================
# Development-only default. For production, set STORAGE_PROVIDER="cloudinary".
# "s3" is not implemented and is rejected in production.
# "local" writes to UPLOAD_DIR; NOT suitable for production (ephemeral/non-durable).
STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE="5242880"
UPLOAD_MAX_FILES_PER_REQUEST="5"
UPLOAD_DAILY_FILE_LIMIT="50"
UPLOAD_DAILY_BYTE_LIMIT="52428800"
UPLOAD_REQUEST_LIMIT="5"

# ============================
# APP CONFIG
# ============================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Exact, comma-separated browser origins allowed to mutate /api.
# Required in production unless NEXT_PUBLIC_APP_URL is explicitly configured.
API_ALLOWED_ORIGINS="http://localhost:3000"
# TRUST_PROXY=true also trusts proxy-supplied host/proto; the proxy must sanitize those headers.

# ============================
# CLOUDINARY (Required for production storage)
# ============================
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
CLOUDINARY_FOLDER="mtruong-store"

# ============================
# IDEMPOTENCY / WEBHOOKS
# ============================
IDEMPOTENCY_RETENTION_HOURS="72"
PAYMENT_IDEMPOTENCY_RETENTION_HOURS="168"
REFUND_IDEMPOTENCY_RETENTION_HOURS="720"
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
WEBHOOK_TOLERANCE_SECONDS="300"
# INVENTORY RESERVATIONS
INVENTORY_RESERVATION_TTL_MINUTES="15"
INVENTORY_MAX_ACTIVE_ORDERS_PER_USER="3"
INVENTORY_EXPIRY_BATCH_SIZE="100"
INVENTORY_MAX_ORDERS_PER_WINDOW="10"
INVENTORY_ORDER_RATE_WINDOW_MINUTES="1"
INVENTORY_TRANSACTION_MAX_ATTEMPTS="4"
INVENTORY_RECONCILIATION_BATCH_SIZE="250"

# TRANSACTIONAL OUTBOX WORKER (MySQL is the source of truth)
OUTBOX_BATCH_SIZE="50"
OUTBOX_POLL_INTERVAL_MS="1000"
OUTBOX_LEASE_SECONDS="60"
OUTBOX_MAX_ATTEMPTS="10"
OUTBOX_BACKOFF_BASE_MS="1000"
OUTBOX_BACKOFF_MAX_MS="300000"
OUTBOX_CONCURRENCY="5"
# Phase 4.3: MUST stay below the platform SIGTERM grace period (Render = 10s),
# otherwise the worker is SIGKILLed mid-shutdown and outbox events stay locked in
# PROCESSING for a full OUTBOX_LEASE_SECONDS cycle.
OUTBOX_SHUTDOWN_TIMEOUT_MS="8000"
OUTBOX_HEARTBEAT_TTL_SECONDS="15"
OUTBOX_DEAD_LETTER_CRITICAL_THRESHOLD="1"
# OUTBOX_REQUIRED_WORKER_VERSION="0.1.0"
# OUTBOX_REQUIRED_WORKER_ID_PREFIX="production-outbox:"

# EMAIL / SMS NOTIFICATIONS
# Default "log" never sends PII outside the app. Use webhook only with HTTPS + hostname allowlist.
NOTIFICATION_PROVIDER="log"
# NOTIFICATION_EMAIL_WEBHOOK_URL="https://notify.example.com/email"
# NOTIFICATION_SMS_WEBHOOK_URL="https://notify.example.com/sms"
# NOTIFICATION_ALLOWED_HOSTS="notify.example.com"
# NOTIFICATION_WEBHOOK_TOKEN="YOUR_NOTIFICATION_PROVIDER_TOKEN"

# ============================
# DEMO/SEED SAFETY (development/demo only)
# ============================
# Production forbids demo seeding and refuses the demo wallet top-up endpoint
# (POST /api/user/balance) unless ENABLE_DEMO_WALLET is explicitly "true".
# Leave this unset/false in production — the demo top-up lets a user mint an
# unbounded wallet balance and then spend it on Banking/MoMo orders.
# DEMO_SEED_ENABLED="false"
# DEMO_SELLER_SETUP_ENABLED="false"
# ENABLE_DEMO_WALLET="false"
# DEMO_ADMIN_PASSWORD="YOUR_DEMO_PASSWORD"
# DEMO_USER_PASSWORD="YOUR_DEMO_PASSWORD"
# DEMO_SHIPPER_PASSWORD="YOUR_DEMO_PASSWORD"
# DEMO_SELLER_PASSWORD="YOUR_DEMO_PASSWORD"

# ============================
# KILL SWITCH (OP9)
# ============================
# Deploy-time maintenance flag enforced by src/middleware.ts. The admin UI toggle
# (siteconfig.maintenanceMode) is DISPLAY-ONLY — nothing reads it. THIS variable
# is what actually sheds traffic: when "true", every non-admin route returns 503
# (admin console, /login, /api/auth and health probes stay reachable).
# Set on the Vercel dashboard + redeploy during an incident. Default: off.
# MAINTENANCE_MODE="false"