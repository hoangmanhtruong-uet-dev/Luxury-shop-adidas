{
  "name": "cun-shop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "tsx scripts/preflight.ts && prisma generate && next build",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "start": "next start",
    "start:web": "next start",
    "start:legacy-all": "tsx scripts/workers/start-all.ts",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "db:migrate": "prisma migrate dev",
    "db:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-products": "tsx prisma/seed-products.ts",
    "db:reset-product-prices": "tsx scripts/setup/reset-product-prices.ts --apply",
    "db:setup-demo-seller": "tsx scripts/setup/setup-demo-seller.ts",
    "db:seed-vouchers": "tsx prisma/seed-vouchers.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "idempotency:cleanup": "tsx scripts/maintenance/cleanup-idempotency.ts",
    "security:cleanup": "tsx scripts/maintenance/cleanup-security-buckets.ts",
    "typecheck": "tsc --noEmit",
    "inventory:expire": "tsx scripts/maintenance/inventory-jobs.ts expire",
    "inventory:reconcile": "tsx scripts/maintenance/inventory-jobs.ts reconcile",
    "inventory:repair": "tsx scripts/maintenance/inventory-jobs.ts repair",
    "outbox:worker": "tsx scripts/workers/outbox-worker.ts worker",
    "outbox:dispatch-once": "tsx scripts/workers/outbox-worker.ts once",
    "outbox:reconcile": "tsx scripts/maintenance/outbox-reconcile.ts",
    "outbox:repair": "tsx scripts/maintenance/outbox-reconcile.ts --repair",
    "money:audit": "tsx scripts/audit/money-audit.ts",
    "preflight": "tsx scripts/preflight.ts",
    "smoke:prod": "bash scripts/smoke-prod.sh",
    "money:static": "node scripts/audit/money-static.mjs",
    "order-state:audit": "node scripts/audit/order-state-audit.mjs",
    "order-state:reconcile": "tsx scripts/maintenance/order-state-reconcile.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "@prisma/client": "^5.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.0.0",
    "csv-parse": "^7.0.3",
    "glob": "^10.5.0",
    "jose": "^6.2.3",
    "js-cookie": "^3.0.1",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "resend": "^6.30.0",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "three": "^0.186.1",
    "tsx": "^4.21.1",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/speakeasy": "^2.0.10",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.10",
    "prisma": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "glob": "^10.5.0",
    "postcss": "^8.5.10"
  }
}
