// Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Runtime (serverless) goes through the Supabase pooler (6543, ?pgbouncer=true).
  // Migrations MUST use a direct connection: DDL inside a pooled transaction-mode
  // session fails or behaves unpredictably. `db:deploy` / `db:migrate` read this.
  directUrl = env("DIRECT_URL")
}

// Enums
enum UserRole {
  user
  admin
  editor
  sale
  warehouse
  shipper
}

enum Gender {
  male
  female
  other
}

enum PaymentMethod {
  cod
  bank_transfer
  momo
  vnpay
  stripe
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum OrderStatus {
  pending
  paid
  payment_failed
  confirmed
  packing
  shipping
  delivered
  expired
  cancelled
  payment_review
  refund_pending
  refunded
  return_requested
  return_approved
  return_rejected
  returning
  returned
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum DiscountType {
  percentage
  fixed
}

model User {
  id                  String               @id @default(cuid())
  code                String               @unique // US001, AD001, etc
  name                String
  email               String               @unique
  password            String
  role                String               @default("user") // "user" | "admin" | "shipper" | "editor" | "sale" | "warehouse"
  isActive            Boolean              @default(true)
  isEmailVerified     Boolean              @default(false)
  isTwoFactorEnabled  Boolean              @default(false)
  twoFactorSecret     String?
  isSeller            Boolean              @default(false)
  phone               String?
  gender              String? // "male" | "female" | "other"
  birthday            DateTime?
  avatar              String?
  balance             Decimal              @default(0) @db.Decimal(19, 4)
  currency            String               @default("VND") @db.Char(3)
  paymentPinHash      String?
  licensePlate        String? // Biển số xe cho Shipper
  transportType       String? // Loại phương tiện: Xe máy, Ô tô...
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  reviews             Review[]
  wishlists           Wishlist[]
  notifications       Notification[]
  orders              Order[]
  shipperOrders       Order[]              @relation("ShipperOrders")
  sellerFulfillments  SellerFulfillment[]  @relation("SellerFulfillments")
  shipperFulfillments SellerFulfillment[]  @relation("ShipperFulfillments")
  products            Product[]            @relation("UserProducts")
  addresses           Address[]
  bankInfos           BankInfo[]
  vouchers            Voucher[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  idempotencyRecords  IdempotencyRecord[]
  payments            Payment[]
  refunds             Refund[]
  walletLedgerEntries WalletLedger[]
  sellerProfile       SellerProfile?
  settlements         SellerSettlement[]
  payoutRequests      PayoutRequest[]
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementActor")
  deliveryAttempts    DeliveryAttempt[]    @relation("DeliveryAttemptShipper")
  codCollections      CodCollection[]      @relation("CodCollector")
  uploadAssets        UploadAsset[]
  uploadQuotaBuckets  UploadQuotaBucket[]
  uploadReservations  UploadReservation[]

  @@index([email])
  @@index([code])
  @@map("user")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_token")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("verification_token")
}

/// Phase 3 (homepage newsletter). Email capture with the welcome voucher code
/// handed out, if any was available at subscribe time.
model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  voucherCode String?
  createdAt   DateTime @default(now())

  @@map("newsletter_subscription")
}

model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?  @db.Text
  discountType  String // "percentage" | "fixed"
  discountValue Decimal  @db.Decimal(19, 4)
  minOrderValue Decimal  @default(0) @db.Decimal(19, 4)
  maxDiscount   Decimal? @db.Decimal(19, 4)
  currency      String   @default("VND") @db.Char(3)
  startDate     DateTime @default(now())
  endDate       DateTime
  usageLimit    Int      @default(100)
  usedCount     Int      @default(0)
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sellerId])
  @@index([code])
  @@map("voucher")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String
  province      String
  district      String
  ward          String
  detailAddress String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("address")
}

model BankInfo {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  accountName   String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("bankinfo")
}

model Product {
  id                    String                 @id @default(cuid())
  code                  String                 @unique // PR001, PR002, etc
  sku                   String?                @unique @db.VarChar(64)
  slug                  String                 @unique
  name                  String
  price                 Decimal                @db.Decimal(19, 4)
  originalPrice         Decimal?               @db.Decimal(19, 4)
  currency              String                 @default("VND") @db.Char(3)
  description           String?                @db.Text
  image                 String?
  emoji                 String?
  gradient              String?
  categoryId            String?
  categoryRef           Category?              @relation(fields: [categoryId], references: [id])
  badge                 String?
  rating                Float                  @default(0)
  reviews               Int                    @default(0) // Legacy count
  inStock               Boolean                @default(true)
  stockQuantity         Int                    @default(100)
  reservedQuantity      Int                    @default(0)
  lowStockThreshold     Int                    @default(5)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  deletedById           String?
  orderItems            OrderItem[]
  reviewsData           Review[]
  wishlists             Wishlist[]
  sellerId              String?
  seller                User?                  @relation("UserProducts", fields: [sellerId], references: [id])
  images                ProductImage[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  flashSaleItems        FlashSaleItem[]

  @@index([sellerId])
  @@index([sellerId, deletedAt, createdAt], map: "product_seller_deleted_created_idx")
  @@index([deletedAt, createdAt], map: "product_deleted_created_idx")
  @@index([categoryId])
  @@index([code])
  // Phase 3.3 (Critical #16): /api/admin/inventory does
  // `orderBy: { stockQuantity: 'asc' }` over the whole catalogue on every
  // dashboard load. `stockQuantity` had no index, so that was a full scan plus
  // a filesort on the hottest read path in the admin UI.
  @@index([stockQuantity], map: "product_stock_quantity_idx")
  @@map("product")
}

model FlashSaleEvent {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     FlashSaleItem[]

  @@index([isActive, startTime, endTime])
  @@map("flash_sale_event")
}

model FlashSaleItem {
  id              String         @id @default(cuid())
  eventId         String
  productId       String
  discountPercent Int            @default(0)
  stockQuantity   Int            @default(0)
  soldQuantity    Int            @default(0)

  event           FlashSaleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([eventId, productId])
  @@map("flash_sale_item")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  approved    Boolean   @default(false)
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("category")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId]) // 1 user = 1 review per product
  @@index([userId])
  @@index([productId])
  @@map("review")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist")
}

model Order {
  id                    String                  @id @default(cuid())
  customerName          String
  customerEmail         String
  customerPhone         String
  shippingAddress       String
  paymentMethod         String
  paymentStatus         String                  @default("pending")
  subtotal              Decimal                 @default(0) @db.Decimal(19, 4)
  discountAmount        Decimal                 @default(0) @db.Decimal(19, 4)
  shippingFee           Decimal                 @default(0) @db.Decimal(19, 4)
  taxAmount             Decimal                 @default(0) @db.Decimal(19, 4)
  shippingProvider      String?
  trackingNumber        String?
  estimatedDelivery     DateTime?
  paidAt                DateTime?
  confirmedAt           DateTime?
  packingStartedAt      DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  returnRequestedAt     DateTime?
  returnedAt            DateTime?
  refundPendingAt       DateTime?
  refundedAt            DateTime?
  total                 Decimal                 @db.Decimal(19, 4)
  currency              String                  @default("VND") @db.Char(3)
  status                String                  @default("pending")
  statusVersion         Int                     @default(0)
  userId                String?
  user                  User?                   @relation(fields: [userId], references: [id])
  shipperId             String?
  shipper               User?                   @relation("ShipperOrders", fields: [shipperId], references: [id])
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  orderItems            OrderItem[]
  idempotencyScope      String?
  idempotencyKey        String?                 @db.VarChar(255)
  payment               Payment?
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  outboxEvents          OutboxEvent[]
  statusTransitions     OrderStatusTransition[]
  returns               OrderReturn[]
  fulfillments          SellerFulfillment[]

  @@unique([idempotencyScope, idempotencyKey])
  @@index([userId])
  @@index([shipperId])
  @@index([status])
  @@index([paymentStatus])
  // Phase 3.3 (Critical #16): the `Order` table had NO index on `createdAt`, yet
  // every order listing and the admin analytics date-window queries sort or
  // filter by it (`orderBy: { createdAt: 'desc' }`, `where: { createdAt: { gte } }`).
  // That is a full table scan + filesort on the largest table in the system, on
  // the most frequently hit admin endpoints.
  @@index([userId, createdAt], map: "order_user_created_idx")
  @@index([createdAt], map: "order_created_idx")
  @@index([status, createdAt], map: "order_status_created_idx")
  @@index([paymentStatus, createdAt], map: "order_payment_status_created_idx")
  @@index([shipperId, status, createdAt], map: "order_shipper_status_created_idx")
  @@map("order")
}

model OrderStatusTransition {
  id             String   @id @default(cuid())
  orderId        String
  fromStatus     String   @db.VarChar(32)
  toStatus       String   @db.VarChar(32)
  actorType      String   @db.VarChar(32)
  actorId        String?  @db.VarChar(191)
  reason         String?  @db.VarChar(500)
  metadata       String?  @db.Text
  idempotencyKey String?  @unique(map: "order_transition_idem_key") @db.VarChar(191)
  requestHash    String?  @db.Char(64)
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], map: "order_transition_order_fk")

  @@index([orderId, createdAt], map: "order_transition_order_created_idx")
  @@index([actorType, actorId], map: "order_transition_actor_idx")
  @@map("order_status_transition")
}

model SellerFulfillment {
  id                    String                        @id @default(cuid())
  orderId               String
  order                 Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "seller_fulfillment_order_fk")
  sellerId              String?
  seller                User?                         @relation("SellerFulfillments", fields: [sellerId], references: [id], map: "seller_fulfillment_seller_fk")
  sellerScope           String                        @db.VarChar(191)
  shipperId             String?
  shipper               User?                         @relation("ShipperFulfillments", fields: [shipperId], references: [id], map: "seller_fulfillment_shipper_fk")
  status                String                        @default("pending") @db.VarChar(32)
  statusVersion         Int                           @default(0)
  subtotal              Decimal                       @default(0) @db.Decimal(19, 4)
  discountAmount        Decimal                       @default(0) @db.Decimal(19, 4)
  shippingFee           Decimal                       @default(0) @db.Decimal(19, 4)
  taxAmount             Decimal                       @default(0) @db.Decimal(19, 4)
  total                 Decimal                       @default(0) @db.Decimal(19, 4)
  currency              String                        @default("VND") @db.Char(3)
  shippingProvider      String?
  trackingNumber        String?
  estimatedDelivery     DateTime?
  confirmedAt           DateTime?
  packingStartedAt      DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  deliveryFailedAt      DateTime?
  deliveryFailureReason String?                       @db.VarChar(500)
  proofOfDeliveryUrl    String?
  proofRecipientName    String?                       @db.VarChar(191)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  orderItems            OrderItem[]
  transitions           SellerFulfillmentTransition[]
  deliveryAttempts      DeliveryAttempt[]
  codCollection         CodCollection?
  settlement            SellerSettlement?
  fulfillmentReturns    FulfillmentReturn[]

  @@unique([orderId, sellerScope], map: "seller_fulfillment_order_scope_key")
  @@index([sellerId, status], map: "seller_fulfillment_seller_status_idx")
  @@index([shipperId, status], map: "seller_fulfillment_shipper_status_idx")
  @@index([status, createdAt], map: "seller_fulfillment_status_created_idx")
  @@map("seller_fulfillment")
}

model SellerFulfillmentTransition {
  id             String            @id @default(cuid())
  fulfillmentId  String
  fulfillment    SellerFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade, map: "fulfillment_transition_fulfillment_fk")
  fromStatus     String            @db.VarChar(32)
  toStatus       String            @db.VarChar(32)
  actorType      String            @db.VarChar(32)
  actorId        String?           @db.VarChar(191)
  reason         String?           @db.VarChar(500)
  metadata       String?           @db.Text
  idempotencyKey String            @unique(map: "fulfillment_transition_idem_key") @db.VarChar(191)
  requestHash    String            @db.Char(64)
  createdAt      DateTime          @default(now())

  @@index([fulfillmentId, createdAt], map: "fulfillment_transition_created_idx")
  @@map("seller_fulfillment_transition")
}

model OrderReturn {
  id             String    @id @default(cuid())
  orderId        String
  status         String    @default("REQUESTED") @db.VarChar(32)
  reason         String    @db.VarChar(500)
  requestedBy    String    @db.VarChar(191)
  idempotencyKey String    @unique(map: "order_return_idem_key") @db.VarChar(191)
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  completedAt    DateTime?
  order          Order     @relation(fields: [orderId], references: [id], map: "order_return_order_fk")

  @@index([orderId, status], map: "order_return_order_status_idx")
  @@map("order_return")
}

model OrderItem {
  id                   String                @id @default(cuid())
  orderId              String
  productId            String
  quantity             Int
  price                Decimal               @db.Decimal(19, 4)
  lineTotal            Decimal               @default(0) @db.Decimal(19, 4)
  currency             String                @default("VND") @db.Char(3)
  order                Order                 @relation(fields: [orderId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  fulfillmentId        String?
  fulfillment          SellerFulfillment?    @relation(fields: [fulfillmentId], references: [id], map: "orderitem_fulfillment_fk")
  inventoryReservation InventoryReservation?

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@index([fulfillmentId], map: "orderitem_fulfillment_idx")
  @@map("orderitem")
}

model InventoryReservation {
  id          String                     @id @default(cuid())
  orderId     String
  orderItemId String                     @unique(map: "inv_res_orderItem_key")
  productId   String
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  consumedAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  order       Order                      @relation(fields: [orderId], references: [id], map: "inv_res_order_fk")
  orderItem   OrderItem                  @relation(fields: [orderItemId], references: [id], map: "inv_res_orderitem_fk")
  product     Product                    @relation(fields: [productId], references: [id], map: "inv_res_product_fk")

  @@index([status, expiresAt], map: "inv_res_status_expires_idx")
  @@index([orderId, status], map: "inv_res_order_status_idx")
  @@index([productId, status], map: "inv_res_product_status_idx")
  @@map("inventory_reservation")
}

model OutboxEvent {
  id             String    @id @default(cuid())
  aggregateType  String    @db.VarChar(64)
  aggregateId    String
  eventType      String    @db.VarChar(96)
  idempotencyKey String    @unique(map: "outbox_event_idem_key") @db.VarChar(191)
  payload        String    @db.Text
  status         String    @default("PENDING") @db.VarChar(32)
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(10)
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lockedUntil    DateTime?
  lockedBy       String?   @db.VarChar(191)
  processedAt    DateTime?
  deadLetteredAt DateTime?
  lastError      String?   @db.Text
  lastErrorCode  String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], map: "outbox_event_order_fk")

  @@index([status, nextAttemptAt, id], map: "outbox_status_next_idx")
  @@index([status, lockedUntil], map: "outbox_status_lease_idx")
  @@index([eventType, status], map: "outbox_type_status_idx")
  @@index([aggregateType, aggregateId], map: "outbox_event_aggregate_idx")
  @@map("outbox_event")
}

model SellerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String    @default("PENDING") @db.VarChar(32)
  businessName     String    @db.VarChar(191)
  taxCode          String?   @db.VarChar(64)
  identityNumber   String?   @db.VarChar(64)
  identityFrontUrl String?
  identityBackUrl  String?
  businessAddress  String    @db.VarChar(500)
  commissionRate   Decimal   @default(5) @db.Decimal(7, 4)
  submittedAt      DateTime  @default(now())
  decidedAt        DateTime?
  decidedBy        String?
  rejectionReason  String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, submittedAt], map: "seller_profile_status_submitted_idx")
  @@map("seller_profile")
}

model InventoryMovement {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  actorId        String?
  actor          User?    @relation("InventoryMovementActor", fields: [actorId], references: [id])
  type           String   @db.VarChar(32)
  quantityDelta  Int
  stockBefore    Int
  stockAfter     Int
  reason         String   @db.VarChar(500)
  referenceType  String?  @db.VarChar(64)
  referenceId    String?
  idempotencyKey String   @unique @db.VarChar(191)
  createdAt      DateTime @default(now())
  Order          Order?   @relation(fields: [orderId], references: [id])
  orderId        String?

  @@index([productId, createdAt], map: "inventory_movement_product_created_idx")
  @@map("inventory_movement")
}

model DeliveryAttempt {
  id             String            @id @default(cuid())
  fulfillmentId  String
  fulfillment    SellerFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  shipperId      String
  shipper        User              @relation("DeliveryAttemptShipper", fields: [shipperId], references: [id])
  outcome        String            @db.VarChar(32)
  proofUrl       String?
  recipientName  String?           @db.VarChar(191)
  note           String?           @db.VarChar(500)
  latitude       Decimal?          @db.Decimal(10, 7)
  longitude      Decimal?          @db.Decimal(10, 7)
  idempotencyKey String            @unique @db.VarChar(191)
  attemptedAt    DateTime          @default(now())

  @@index([fulfillmentId, attemptedAt], map: "delivery_attempt_fulfillment_idx")
  @@map("delivery_attempt")
}

model CodCollection {
  id            String            @id @default(cuid())
  fulfillmentId String            @unique
  fulfillment   SellerFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  collectedById String
  collectedBy   User              @relation("CodCollector", fields: [collectedById], references: [id])
  amount        Decimal           @db.Decimal(19, 4)
  currency      String            @default("VND") @db.Char(3)
  status        String            @default("COLLECTED") @db.VarChar(32)
  collectedAt   DateTime          @default(now())
  remittedAt    DateTime?

  @@index([status, collectedAt], map: "cod_collection_status_idx")
  @@map("cod_collection")
}

model SellerSettlement {
  id               String            @id @default(cuid())
  fulfillmentId    String            @unique
  fulfillment      SellerFulfillment @relation(fields: [fulfillmentId], references: [id])
  sellerId         String
  seller           User              @relation(fields: [sellerId], references: [id])
  grossAmount      Decimal           @db.Decimal(19, 4)
  commissionRate   Decimal           @db.Decimal(7, 4)
  commissionAmount Decimal           @db.Decimal(19, 4)
  netAmount        Decimal           @db.Decimal(19, 4)
  currency         String            @default("VND") @db.Char(3)
  status           String            @default("AVAILABLE") @db.VarChar(32)
  availableAt      DateTime          @default(now())
  paidAt           DateTime?
  payoutRequestId  String?
  payoutRequest    PayoutRequest?    @relation(fields: [payoutRequestId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([sellerId, status, availableAt], map: "seller_settlement_seller_status_idx")
  @@map("seller_settlement")
}

model PayoutRequest {
  id              String             @id @default(cuid())
  sellerId        String
  seller          User               @relation(fields: [sellerId], references: [id])
  bankInfoId      String
  amount          Decimal            @db.Decimal(19, 4)
  currency        String             @default("VND") @db.Char(3)
  status          String             @default("PENDING") @db.VarChar(32)
  requestedAt     DateTime           @default(now())
  processedAt     DateTime?
  processedBy     String?
  rejectionReason String?            @db.VarChar(500)
  settlements     SellerSettlement[]

  @@index([sellerId, status, requestedAt], map: "payout_request_seller_status_idx")
  @@map("payout_request")
}

model FulfillmentReturn {
  id             String            @id @default(cuid())
  fulfillmentId  String
  fulfillment    SellerFulfillment @relation(fields: [fulfillmentId], references: [id])
  requesterId    String
  status         String            @default("REQUESTED") @db.VarChar(32)
  reason         String            @db.VarChar(500)
  evidenceUrl    String?
  requestedAt    DateTime          @default(now())
  decidedAt      DateTime?
  completedAt    DateTime?
  idempotencyKey String            @unique @db.VarChar(191)

  @@index([fulfillmentId, status], map: "fulfillment_return_status_idx")
  @@map("fulfillment_return")
}

model SiteConfig {
  id                String    @id @default("default")
  siteName          String    @default("MTRUONG-STORE")
  hotline           String    @default("1900 8888")
  contactEmail      String    @default("support@mtruong.store")
  address           String?   @default("Việt Nam")
  codEnabled        Boolean   @default(true)
  momoEnabled       Boolean   @default(true)
  bankingEnabled    Boolean   @default(true)
  vnpayEnabled      Boolean   @default(false)
  stripeEnabled     Boolean   @default(false)
  lowStockThreshold Int       @default(10)
  maintenanceMode   Boolean   @default(false)
  lastBackupAt      DateTime?
  updatedAt         DateTime  @updatedAt

  @@map("siteconfig")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("productimage")
}

model IdempotencyRecord {
  id             String    @id @default(cuid())
  key            String    @db.VarChar(255)
  scopeId        String
  user           User      @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  operation      String
  method         String    @db.VarChar(16)
  requestHash    String    @db.Char(64)
  status         String    @default("PROCESSING") @db.VarChar(32)
  responseStatus Int?
  responseBody   String?   @db.Text
  resourceType   String?   @db.VarChar(64)
  resourceId     String?
  errorCode      String?
  lockedAt       DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scopeId, operation, key])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([status, lockedAt])
  @@map("idempotency_record")
}

model Payment {
  id                     String   @id @default(cuid())
  orderId                String   @unique
  order                  Order    @relation(fields: [orderId], references: [id])
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  amount                 Decimal  @db.Decimal(19, 4)
  status                 String   @default("completed") @db.VarChar(32)
  operation              String
  idempotencyKey         String   @db.VarChar(255)
  provider               String   @default("internal_wallet") @db.VarChar(64)
  providerOutcome        String   @default("SUCCEEDED") @db.VarChar(64)
  providerIdempotencyKey String   @unique
  providerTransactionId  String   @unique
  currency               String   @default("VND") @db.Char(3)
  refundedAmount         Decimal  @default(0) @db.Decimal(19, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  refunds                Refund[]

  @@unique([userId, operation, idempotencyKey])
  @@index([userId, createdAt])
  @@map("payment")
}

model Refund {
  id               String        @id @default(cuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  amount           Decimal       @db.Decimal(19, 4)
  status           String        @default("completed") @db.VarChar(32)
  operation        String
  idempotencyKey   String        @db.VarChar(255)
  provider         String        @default("internal_wallet") @db.VarChar(64)
  providerOutcome  String        @default("SUCCEEDED") @db.VarChar(64)
  providerRefundId String?       @unique
  sourceEventId    String?       @unique(map: "refund_source_event_key")
  approvalKey      String?       @unique(map: "refund_approval_key") @db.VarChar(191)
  currency         String        @default("VND") @db.Char(3)
  approvedBy       String?
  approvedAt       DateTime?
  completedAt      DateTime?
  failureReason    String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  walletLedger     WalletLedger?

  @@unique([userId, operation, idempotencyKey])
  @@index([paymentId, createdAt])
  @@map("refund")
}

model ProcessedOutboxEvent {
  id           String   @id @default(cuid())
  consumerName String   @db.VarChar(96)
  eventId      String
  resultHash   String?  @db.Char(64)
  processedAt  DateTime @default(now())

  @@unique([consumerName, eventId], map: "processed_consumer_event_key")
  @@index([eventId], map: "processed_event_idx")
  @@map("processed_outbox_event")
}

model NotificationDelivery {
  id                     String    @id @default(cuid())
  eventId                String
  consumerName           String    @db.VarChar(96)
  idempotencyKey         String    @unique(map: "notification_idem_key") @db.VarChar(191)
  channel                String    @default("log") @db.VarChar(32)
  recipient              String    @db.VarChar(191)
  template               String    @db.VarChar(96)
  status                 String    @default("pending") @db.VarChar(32)
  providerMessageId      String?   @db.VarChar(191)
  providerIdempotencyKey String    @unique(map: "notification_provider_idem_key") @db.VarChar(191)
  lastError              String?   @db.Text
  sentAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([consumerName, eventId], map: "notification_consumer_event_key")
  @@index([status, createdAt], map: "notification_status_created_idx")
  @@map("notification_delivery")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  type      String   @default("info") // info, success, warning, error
  link      String?  // Optional link to related entity
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notification")
}


model WalletLedger {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], map: "wallet_ledger_user_fk")
  refundId         String?  @unique(map: "wallet_ledger_refund_key")
  refund           Refund?  @relation(fields: [refundId], references: [id], map: "wallet_ledger_refund_fk")
  deterministicKey String   @unique(map: "wallet_ledger_deterministic_key") @db.VarChar(191)
  referenceType    String   @db.VarChar(64)
  referenceId      String   @db.VarChar(191)
  amount           Decimal  @db.Decimal(19, 4)
  balanceBefore    Decimal  @db.Decimal(19, 4)
  balanceAfter     Decimal  @db.Decimal(19, 4)
  currency         String   @default("VND") @db.Char(3)
  entryType        String   @db.VarChar(64)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt], map: "wallet_ledger_user_created_idx")
  @@map("wallet_ledger")
}

model DomainAuditLog {
  id         String   @id @default(cuid())
  action     String   @db.VarChar(96)
  actorId    String?  @db.VarChar(191)
  entityType String   @db.VarChar(64)
  entityId   String   @db.VarChar(191)
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt], map: "audit_entity_created_idx")
  @@index([action, createdAt], map: "audit_action_created_idx")
  @@map("domain_audit_log")
}

model WorkerHeartbeat {
  workerId      String    @id @db.VarChar(191)
  status        String    @db.VarChar(32)
  version       String    @db.VarChar(64)
  lastPollAt    DateTime
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  inflight      Int       @default(0)
  expiresAt     DateTime
  lastError     String?   @db.Text
  updatedAt     DateTime  @updatedAt

  @@index([status, expiresAt], map: "worker_status_expires_idx")
  @@map("worker_heartbeat")
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @db.VarChar(64)
  providerEventId String
  requestHash     String    @db.Char(64)
  eventType       String
  status          String    @default("PROCESSING") @db.VarChar(32)
  orderId         String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
  @@map("webhook_event")
}

model RateLimitBucket {
  keyHash     String   @id @db.Char(64)
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt], map: "rate_limit_expires_idx")
  @@map("rate_limit_bucket")
}

model UploadQuotaBucket {
  userId       String
  periodStart  DateTime
  requestCount Int      @default(0)
  fileCount    Int      @default(0)
  bytesUsed    BigInt   @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "upload_quota_user_fk")

  @@id([userId, periodStart])
  @@index([expiresAt], map: "upload_quota_expires_idx")
  @@map("upload_quota_bucket")
}

model UploadReservation {
  id               String   @id @default(cuid())
  userId           String
  quotaPeriodStart DateTime
  fileCount        Int
  bytesReserved    BigInt
  storageKeys      String?  @db.Text
  status           String   @default("RESERVED") @db.VarChar(32)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "upload_reservation_user_fk")

  @@index([status, expiresAt], map: "upload_reservation_cleanup_idx")
  @@index([userId, createdAt], map: "upload_reservation_user_created_idx")
  @@map("upload_reservation")
}

model UploadAsset {
  id           String   @id @default(cuid())
  userId       String
  storageKey   String   @unique(map: "upload_asset_storage_key") @db.VarChar(255)
  url          String   @unique(map: "upload_asset_url_key") @db.VarChar(512)
  purpose      String   @db.VarChar(32)
  resourceId   String?  @db.VarChar(191)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(64)
  sizeBytes    BigInt
  status       String   @default("AVAILABLE") @db.VarChar(32)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "upload_asset_user_fk")

  @@index([userId, purpose, status], map: "upload_asset_owner_purpose_idx")
  @@index([resourceId, purpose], map: "upload_asset_resource_idx")
  @@index([status, createdAt], map: "upload_asset_cleanup_idx")
  @@map("upload_asset")
}
